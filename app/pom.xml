<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>ro.cristivoicu</groupId>
    <artifactId>spring-boot-restless</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-boot-restless</name>
    <description>Annotation-driven REST CRUD for Spring Boot, built around DDD and volatility-based design.</description>
    <url>https://github.com/cristivoicu/spring-boot-restless</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Cristian Voicu</name>
            <email>mariancristianvoicu@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/cristivoicu/spring-boot-restless.git</connection>
        <developerConnection>scm:git:https://github.com/cristivoicu/spring-boot-restless.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/cristivoicu/spring-boot-restless</url>
    </scm>
    <properties>
        <java.version>17</java.version>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- @RestlessEntity has SOURCE retention (compile-time only, see its javadoc), so
             provided scope is enough - it never needs to be present at runtime. -->
        <dependency>
            <groupId>ro.cristivoicu</groupId>
            <artifactId>spring-boot-restless-processor</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- optional=true: compiled against so ro.cristivoicu.springbootrestless.openapi can
             build a real OpenAPI document for dynamically-registered routes (see that package's
             javadoc for why springdoc's own @RestController scanning can't find them on its
             own), but never forced onto a consumer that doesn't want Swagger at all - Maven's
             optional flag keeps it out of anything depending on this artifact transitively.
             RestlessOpenApiCustomizer's own @ConditionalOnClass is what makes this a no-op,
             not an error, when the consumer genuinely has no springdoc on their classpath. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- optional=true, same reasoning as springdoc above: compiled against so
             ro.cristivoicu.springbootrestless.metrics can record an authorization-denial counter
             via Micrometer's MeterRegistry (riding in transitively with this), but never forced
             onto a consumer with no Actuator on their classpath - RestlessAuthorizationMetrics's
             own @ConditionalOnClass(MeterRegistry.class) is what makes that a no-op, not an
             error. Same block cerbos/pom.xml already uses for CerbosHealthIndicator. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Ground rules Phase 3 item 17: backs this module's package-info.java @NullMarked
             annotations - documentation of intent only, no null-checking build step (NullAway,
             an IDE inspection, ...) wired in here, that's a separate, bigger decision. Version
             managed by spring-boot-starter-parent, same as every other unversioned dependency
             above. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No spring-boot-maven-plugin here: app is a library (no @SpringBootApplication
                 class in src/main - it moved to src/test, since app is never run standalone
                 anymore, only self-tested). spring-boot-maven-plugin's repackage goal needs a
                 main class to repackage and would fail without one; a plain jar (built by the
                 default maven-jar-plugin from spring-boot-starter-parent) is also what "example"
                 needs to consume app's classes as a normal dependency - repackaging (classes
                 nested under BOOT-INF/) would have broken that anyway. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>ro.cristivoicu</groupId>
                            <artifactId>spring-boot-restless-processor</artifactId>
                            <version>0.0.1-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Ground rules Phase 3 item 17: per-module coverage report (target/site/jacoco/
                 index.html after `mvn verify`) - no shared pluginManagement to hang this off,
                 since this module parents to spring-boot-starter-parent directly, not the
                 reactor root pom (see that pom's own description for why). -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Ground rules Phase 3 item 17: wired against the stable-surface packages (see
                 the README's "Versioning and API Stability" section for the full list by class
                 name), but there is no previously published release of this artifact to diff
                 against yet - only 0.0.1-SNAPSHOT, nothing on Maven Central.
                 ignoreMissingOldVersion makes that a correctly-wired no-op today (oldVersion's
                 RELEASE simply can't resolve) rather than a build failure; it starts actually
                 comparing the moment a real first version is published. Not a meaningful
                 enforcement gate until then - flagging that plainly rather than faking a
                 baseline. -->
            <plugin>
                <groupId>com.github.siom79.japicmp</groupId>
                <artifactId>japicmp-maven-plugin</artifactId>
                <version>0.26.3</version>
                <configuration>
                    <oldVersion>
                        <dependency>
                            <groupId>${project.groupId}</groupId>
                            <artifactId>${project.artifactId}</artifactId>
                            <version>RELEASE</version>
                        </dependency>
                    </oldVersion>
                    <newVersion>
                        <file>
                            <path>${project.build.directory}/${project.build.finalName}.jar</path>
                        </file>
                    </newVersion>
                    <parameter>
                        <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                        <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
                        <breakBuildOnSourceIncompatibleModifications>false</breakBuildOnSourceIncompatibleModifications>
                        <includes>
                            <include>ro.cristivoicu.springbootrestless.resource</include>
                            <include>ro.cristivoicu.springbootrestless.authorization</include>
                            <include>ro.cristivoicu.springbootrestless.annotation</include>
                            <include>ro.cristivoicu.springbootrestless.embed</include>
                            <include>ro.cristivoicu.springbootrestless.controller.create</include>
                            <include>ro.cristivoicu.springbootrestless.controller.read</include>
                            <include>ro.cristivoicu.springbootrestless.controller.update</include>
                            <include>ro.cristivoicu.springbootrestless.controller.patch</include>
                            <include>ro.cristivoicu.springbootrestless.controller.delete</include>
                            <include>ro.cristivoicu.springbootrestless.datasource</include>
                            <include>ro.cristivoicu.springbootrestless.datasource.defaults</include>
                            <include>ro.cristivoicu.springbootrestless.mapper</include>
                            <include>ro.cristivoicu.springbootrestless.models</include>
                        </includes>
                    </parameter>
                </configuration>
                <executions>
                    <execution>
                        <phase>verify</phase>
                        <goals>
                            <goal>cmp</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
