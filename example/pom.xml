<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>ro.cristivoicu</groupId>
    <artifactId>spring-boot-restless-example</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>spring-boot-restless-example</name>
    <description>Standalone implementation example: consumes spring-boot-restless (the
        framework) and spring-boot-restless-processor as a real external project would, under
        its own package.</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <!-- Imported, not hand-pinned per dependency below - example is the one place in this
         reactor meant to look like a real external consumer, so it's also the one place that
         demonstrates importing spring-boot-restless-dependencies instead of repeating
         "0.0.1-SNAPSHOT" on every ro.cristivoicu dependency by hand (see the root README's
         Cerbos-dependency step for the same snippet). -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ro.cristivoicu</groupId>
                <artifactId>spring-boot-restless-dependencies</artifactId>
                <version>0.0.1-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The framework itself - version resolved via the BOM import above. -->
        <dependency>
            <groupId>ro.cristivoicu</groupId>
            <artifactId>spring-boot-restless</artifactId>
        </dependency>

        <!-- The Cerbos-backed AuthorizationGuard, wired into EmployeeRestlessResource below. -->
        <dependency>
            <groupId>ro.cristivoicu</groupId>
            <artifactId>spring-boot-restless-cerbos</artifactId>
        </dependency>

        <!-- Activates CerbosHealthIndicator (cerbos module, @ConditionalOnClass on this) -
             see application.properties for exposing it on /actuator/health. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT Bearer auth: SecurityConfig decodes the token and populates Authentication as a
             JwtAuthenticationToken, which CerbosPrincipalResolver (in the cerbos module) reads. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- provided, not transitive from the "app" dependency - each module that has its own
             @RestlessEntity-annotated sources needs its own compile-time reference. -->
        <dependency>
            <groupId>ro.cristivoicu</groupId>
            <artifactId>spring-boot-restless-processor</artifactId>
            <version>0.0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- A real runtime dependency now, not test-scoped: the spike that used to justify the
             test scope (see OpenApiDiscoveryTest, formerly OpenApiDiscoverySpikeTest) found that
             springdoc's own @RestController scanning does NOT see routes RestlessRegistrar
             registers dynamically - app's own RestlessOpenApiCustomizer (a springdoc
             GlobalOpenApiCustomizer, @ConditionalOnClass-gated on springdoc being present, see
             its javadoc) is what fixes that, and it needs springdoc actually on the classpath at
             runtime to ever activate. /swagger-ui.html and /v3/api-docs both work out of the box
             the moment this dependency is added - no extra configuration. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- RestlessErrorAssertions/RestlessPageAssertions - version resolved via the BOM import
             above, same as spring-boot-restless/spring-boot-restless-cerbos. -->
        <dependency>
            <groupId>ro.cristivoicu</groupId>
            <artifactId>spring-boot-restless-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- @WithMockUser / SecurityMockMvcRequestPostProcessors.jwt() - pre-populates the
             security context for a MockMvc request instead of needing a real signed token
             verified by SecurityConfig's JwtDecoder. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- CerbosContainer (bundled in cerbos-sdk-java, a transitive dependency of
             spring-boot-restless-cerbos) extends Testcontainers' GenericContainer - junit-jupiter
             brings the @Testcontainers/@Container JUnit 5 extension. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>ro.cristivoicu</groupId>
                            <artifactId>spring-boot-restless-processor</artifactId>
                            <version>0.0.1-SNAPSHOT</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
