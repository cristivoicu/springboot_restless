<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ro.cristivoicu</groupId>
    <artifactId>spring-boot-restless-reactor</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>spring-boot-restless-reactor</name>
    <description>Reactor build: the annotation processor must be a separately-built artifact
        from the code that uses it (it can't process its own compilation unit), so "processor"
        builds first and "app" depends on it. "example" is a standalone consumer of "app" (the
        library) and "processor", demonstrating real usage under its own package.</description>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Cristian Voicu</name>
            <email>mariancristianvoicu@gmail.com</email>
        </developer>
    </developers>

    <url>https://github.com/cristivoicu/springboot_restless</url>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <url>https://github.com/cristivoicu/springboot_restless</url>
        <connection>scm:git:https://github.com/cristivoicu/springboot_restless.git</connection>
        <developerConnection>scm:git:https://github.com/cristivoicu/springboot_restless.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>processor</module>
        <module>app</module>
        <module>cerbos</module>
        <module>spring-boot-restless-test</module>
        <module>spring-boot-restless-dependencies</module>
        <module>example</module>
    </modules>

    <!-- Maven Central publishing - see the README's "Publishing a release" section.
         ./mvnw -P release -pl '!example' deploy -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central requires a sources and a javadoc jar next to every jar. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Uploaded and validated, then published by hand from
                                 central.sonatype.com - a release can never be deleted. -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
