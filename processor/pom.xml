<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ro.cristivoicu</groupId>
        <artifactId>spring-boot-restless-reactor</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>spring-boot-restless-processor</artifactId>
    <packaging>jar</packaging>
    <name>spring-boot-restless-processor</name>
    <description>The @RestlessEntity annotation and the compile-time processor that generates a
        {Entity}RestlessResource class from it. A separately-built artifact from "app" on
        purpose: an annotation processor can't process its own compilation unit.</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Only needed so the id-field-detection code can reference the annotation's fully
             qualified name; entities in "app" already depend on the real jakarta.persistence
             artifact via spring-boot-starter-data-jpa, this module never needs it as a real
             dependency since it only ever compares annotation-mirror strings. -->

        <!-- Ground rules Phase 3 item 17: backs this module's package-info.java @NullMarked
             annotations. Pinned, same reasoning as every other dependency/plugin version in
             this pom - no spring-boot-starter-parent to inherit a managed version from. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.1</version>
        </dependency>

        <!-- Test-only: RestlessEntityProcessorMassAssignmentTest drives the real javax.tools
             JavaCompiler API in-memory (no extra compile-testing library needed) to assert this
             processor actually raises the compile errors Ground rules item 6 requires - the only
             way to test a Diagnostic.Kind.ERROR without breaking the reactor's own build. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>6.0.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- This module IS an annotation processor - it must not try to run one on
                         itself (there is none registered for its own sources), and disabling
                         also sidesteps any accidental self-processing edge cases. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
            <!-- Pinned (this module has no spring-boot-starter-parent to inherit a matching
                 version from, unlike every other module in the reactor) to a version already
                 resolvable offline in this environment, JUnit Platform provider included. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>

            <!-- Ground rules Phase 3 item 17: per-module coverage report, same as app/cerbos -
                 pinned, same reasoning as every other plugin version in this pom. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
