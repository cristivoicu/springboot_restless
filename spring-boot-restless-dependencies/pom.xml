<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.cristivoicu</groupId>
    <artifactId>spring-boot-restless-dependencies</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>spring-boot-restless-dependencies</name>
    <description>Bill of materials for spring-boot-restless: import this into a consuming
        application's own &lt;dependencyManagement&gt; to pull in matching, tested-together
        versions of "spring-boot-restless" (the core library), "spring-boot-restless-cerbos"
        (optional Cerbos-backed authorization), and "spring-boot-restless-test" (MockMvc/AssertJ
        test helpers) without hand-pinning each one's version separately. Deliberately no
        &lt;parent&gt; (a BOM's whole point is being importable by a consumer whose own parent is
        something else entirely, e.g. their own company parent POM) and no &lt;dependencies&gt; -
        only &lt;dependencyManagement&gt;, so importing it never forces any of these three
        artifacts onto the classpath by itself; a consumer still declares whichever ones they
        actually want, just without a version.
    </description>
    <url>https://github.com/cristivoicu/springboot_restless</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Cristian Voicu</name>
            <email>mariancristianvoicu@gmail.com</email>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/cristivoicu/springboot_restless</url>
        <connection>scm:git:https://github.com/cristivoicu/springboot_restless.git</connection>
        <developerConnection>scm:git:https://github.com/cristivoicu/springboot_restless.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.cristivoicu</groupId>
                <artifactId>spring-boot-restless</artifactId>
                <version>0.0.1</version>
            </dependency>
            <dependency>
                <groupId>io.github.cristivoicu</groupId>
                <artifactId>spring-boot-restless-cerbos</artifactId>
                <version>0.0.1</version>
            </dependency>
            <dependency>
                <groupId>io.github.cristivoicu</groupId>
                <artifactId>spring-boot-restless-test</artifactId>
                <version>0.0.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Maven Central publishing - see the README's "Publishing a release" section.
         ./mvnw -P release -pl '!example' deploy -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Uploaded and validated, then published by hand from
                                 central.sonatype.com - a release can never be deleted. -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
